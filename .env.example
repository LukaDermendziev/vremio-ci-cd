# Copy to .env in the repo root and fill in real values.
# Never commit .env — it is gitignored.

# ── Django core ──────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# HTTPS domains for CSRF (required in production behind HTTPS).
# In production with DJANGO_DEBUG=False, https:// origins are also auto-added
# from DJANGO_ALLOWED_HOSTS + CUSTOMER_DOMAINS + RAILWAY_PUBLIC_DOMAIN.
# CSRF_TRUSTED_ORIGINS=https://www.fancyfingers.mk,https://fancyfingers.mk

# Public site URL — customer emails, verify links, manage-booking links.
# Local: http://127.0.0.1:8000
# Railway testing: USE_RAILWAY_SITE_URL=True (uses your *.up.railway.app URL)
# Production: SITE_URL=https://www.fancyfingers.mk and USE_RAILWAY_SITE_URL=False
SITE_URL=http://127.0.0.1:8000
# USE_RAILWAY_SITE_URL=True

# Salon-branded domain(s): / on these hosts redirects to the salon page.
# CUSTOMER_DOMAINS=www.fancyfingers.mk,fancyfingers.mk
# CUSTOMER_DOMAIN_SALON_SLUG=fancy-fingers

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL is REQUIRED when DJANGO_DEBUG=False (SQLite is local dev only).

# Option A: single URL (Render, Railway, Fly.io, etc.)
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Option B: discrete PostgreSQL variables (leave unset for local SQLite)
# POSTGRES_DB=salon_scheduler
# POSTGRES_USER=salon_user
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# ── Cache (recommended in production with multiple Gunicorn workers) ─────────
# Redis URL for shared rate limiting / anti-abuse counters
# CACHE_URL=redis://127.0.0.1:6379/1
# On Railway: add a Redis service, then set CACHE_URL to the private Redis URL
# reference (e.g. ${{Redis.REDIS_PRIVATE_URL}}). Needed for shared rate limits
# and owner login lockout across multiple Gunicorn workers.

# ── Error monitoring (optional) ──────────────────────────────────────────────
# Create a Sentry project, copy the DSN, set it on Railway Variables.
# Leave unset locally / until you want error alerts.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0

# ── Email ────────────────────────────────────────────────────────────────────
# Development (default): emails print to the console — no SMTP needed locally
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Production on Railway (recommended): Brevo HTTPS API — works on Hobby/Free
# (Railway blocks outbound SMTP on ports 587/465 unless you are on Pro)
# BREVO_API_KEY=xkeysib-your-brevo-api-key
# BREVO_SMS_SENDER=FancyFingers
# DEFAULT_FROM_EMAIL=Fancy Fingers Booking <noreply@fancyfingers.mk>
# OWNER_NOTIFICATION_EMAIL=owner@yourdomain.com
# VREMIO_CONTACT_EMAIL=contact.vremio@gmail.com
# VREMIO_INSTAGRAM=vremio.mk

# SMTP (local testing or Railway Pro only):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-brevo-login-email
# EMAIL_HOST_PASSWORD=your-brevo-smtp-key
# DEFAULT_FROM_EMAIL=Fancy Fingers Booking <noreply@yourdomain.com>

# Customer email is optional when SMS verification is enabled on the booking policy.
# Reply-To on customer emails uses OWNER_NOTIFICATION_EMAIL or the owner account email.

# ── SMS (Brevo transactional) ─────────────────────────────────────────────────
# BREVO_SMS_SENDER must be registered in your Brevo account (max 11 alphanumeric).
# BREVO_SMS_SENDER=SalonName

# ── Media (optional) ─────────────────────────────────────────────────────────
# Local default: backend/media/
# Railway: attach a volume at /app/media and set MEDIA_ROOT=/app/media
# MEDIA_ROOT=/app/media

# ── Image moderation (optional) ──────────────────────────────────────────────
# IMAGE_MODERATION_ENABLED=False
# IMAGE_MODERATION_PROVIDER=

# ── Production security (when DJANGO_DEBUG=False) ────────────────────────────
# SECURE_SSL_REDIRECT=True
# USE_SECURE_PROXY_SSL_HEADER=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_PRELOAD=False
